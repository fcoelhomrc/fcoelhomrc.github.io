---
// Links the parts of a blog series, marking the one being read.
interface Props {
  title: string;
  parts: { slug: string; title: string }[];
  current: string;
}

const { title, parts, current } = Astro.props;
const root = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<nav class="series" aria-label={title}>
  <p class="series-title">{title}</p>
  <ol>
    {parts.map((p) => (
      <li>
        {p.slug === current
          ? <span aria-current="page">{p.title}</span>
          : <a href={`${root}blog/${p.slug}/`}>{p.title}</a>}
      </li>
    ))}
  </ol>
</nav>
