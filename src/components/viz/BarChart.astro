---
// Grouped columns with optional 95% interval whiskers. Each bar is its own
// hover and focus target. Several views share the axes; buttons swap them.
import Frame from "./Frame.astro";
import { fmt } from "./palette";

interface Bar { name: string; value: number; lo?: number; hi?: number }
interface Group { label: string; bars: Bar[] }
interface Props {
  title: string;
  subtitle?: string;
  yLabel: string;
  yDomain: [number, number];
  yStep: number;
  views: { label: string; groups: Group[] }[];
  colors: Record<string, string>;
  groupLabel?: string;
  digits?: number;
  reference?: { value: number; label: string };
  source?: string;
}

const { title, subtitle, yLabel, yDomain, yStep, views, colors, groupLabel = "", digits = 3, reference, source } = Astro.props;

const W = 640, H = 290, L = 48, R = 18, T = 14, B = 40;
const sy = (v: number) => T + (1 - (v - yDomain[0]) / (yDomain[1] - yDomain[0])) * (H - T - B);
const yTicks: number[] = [];
for (let v = yDomain[0]; v <= yDomain[1] + 1e-9; v += yStep) yTicks.push(Math.round(v * 1000) / 1000);

const nGroups = views[0].groups.length;
const nBars = Math.max(...views.flatMap((v) => v.groups.map((g) => g.bars.length)));
const band = (W - L - R) / nGroups;
const barW = Math.min(22, (band * 0.78) / nBars - 2);
const gap = 2;
const groupX = (gi: number) => L + band * gi + band / 2;
const barX = (gi: number, bi: number, n: number) => groupX(gi) - (n * (barW + gap) - gap) / 2 + bi * (barW + gap);

// 4px rounded data end, square at the baseline.
const column = (x: number, v: number) => {
  const top = sy(Math.max(v, yDomain[0])), base = sy(yDomain[0]);
  const r = Math.min(4, (base - top) / 2, barW / 2);
  return `M${x} ${base} V${top + r} Q${x} ${top} ${x + r} ${top} H${x + barW - r} Q${x + barW} ${top} ${x + barW} ${top + r} V${base} Z`;
};

const names = [...new Set(views.flatMap((v) => v.groups.flatMap((g) => g.bars.map((b) => b.name))))];
const legend: { name: string; color: string; kind: "rect" | "dash" }[] = names.map((n) => ({ name: n, color: colors[n], kind: "rect" }));
if (reference) legend.push({ name: reference.label, color: "var(--subtle)", kind: "dash" as const });
const hasCI = views.some((v) => v.groups.some((g) => g.bars.some((b) => b.lo !== undefined)));
const tip = (g: Group, b: Bar) =>
  JSON.stringify({
    title: `${g.label}`,
    rows: [{ name: b.name + (b.lo !== undefined ? ` (95% CI ${fmt(b.lo, digits)}–${fmt(b.hi!, digits)})` : ""), color: colors[b.name], value: fmt(b.value, digits) }],
  });
const tables = views.map((view) => ({
  columns: [groupLabel || "Group", ...names],
  rows: view.groups.map((g) => [
    g.label,
    ...names.map((n) => {
      const b = g.bars.find((b) => b.name === n);
      if (!b) return "–";
      return hasCI && b.lo !== undefined ? `${fmt(b.value, digits)} (${fmt(b.lo, digits)}–${fmt(b.hi!, digits)})` : fmt(b.value, digits);
    }),
  ]),
}));
---

<Frame title={title} subtitle={subtitle} views={views.map((v) => v.label)} legend={legend} tables={tables} source={source}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
    {yTicks.map((v) => (
      <g>
        <line class={v === yDomain[0] ? "viz-baseline" : "viz-grid"} x1={L} x2={W - R} y1={sy(v)} y2={sy(v)} />
        <text x={L - 8} y={sy(v) + 3.5} text-anchor="end">{v.toFixed(yStep >= 1 ? 0 : yStep < 0.1 ? 2 : 1)}</text>
      </g>
    ))}
    {views[0].groups.map((g, gi) => <text class="viz-label" x={groupX(gi)} y={H - B + 16} text-anchor="middle">{g.label}</text>)}
    {groupLabel && <text class="viz-axis-title" x={(L + W - R) / 2} y={H - 4} text-anchor="middle">{groupLabel}</text>}
    <text class="viz-axis-title" transform={`translate(12 ${(T + H - B) / 2}) rotate(-90)`} text-anchor="middle">{yLabel}</text>
    {views.map((view, vi) => (
      <g data-view-panel={String(vi)} style={vi === 0 ? "" : "display:none"}>
        {view.groups.map((g, gi) =>
          g.bars.map((b, bi) => {
            const x = barX(gi, bi, g.bars.length);
            return (
              <g data-tip={tip(g, b)} tabindex="0">
                <rect class="viz-hitbox" x={x - 1} y={T} width={barW + 2} height={H - T - B} />
                <path class="viz-mark" d={column(x, b.value)} fill={colors[b.name]} />
                {b.lo !== undefined && (
                  <g>
                    <line class="viz-whisker" x1={x + barW / 2} x2={x + barW / 2} y1={sy(b.lo)} y2={sy(b.hi!)} />
                    <line class="viz-whisker" x1={x + barW / 2 - 3} x2={x + barW / 2 + 3} y1={sy(b.hi!)} y2={sy(b.hi!)} />
                    <line class="viz-whisker" x1={x + barW / 2 - 3} x2={x + barW / 2 + 3} y1={sy(b.lo)} y2={sy(b.lo)} />
                  </g>
                )}
              </g>
            );
          }),
        )}
      </g>
    ))}
    {reference && <line class="viz-ref" x1={L} x2={W - R} y1={sy(reference.value)} y2={sy(reference.value)} />}
  </svg>
</Frame>
