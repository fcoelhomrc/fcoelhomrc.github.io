---
// Judge verdicts against human labels, as a 2×2 grid. Cell shade is a
// one-hue sequential step by count, so the diagonal reads at a glance.
import "./viz.css";

interface Props {
  title: string;
  subtitle?: string;
  tp: number;
  tn: number;
  fp: number;
  fn: number;
  source?: string;
}

const { title, subtitle, tp, tn, fp, fn, source } = Astro.props;
const max = Math.max(tp, tn, fp, fn);
// Blue ramp steps 600 → 400 on the dark surface.
const shade = (n: number) => (n === 0 ? "transparent" : n / max > 0.66 ? "#256abf" : n / max > 0.33 ? "#1c5cab" : "#184f95");
const cells = [
  { n: tp, label: "Both say supported", row: "Human: supported", col: "Judge: supported" },
  { n: fn, label: "Judge flags a claim the human accepts", row: "Human: supported", col: "Judge: unsupported" },
  { n: fp, label: "Judge accepts a claim the human rejects", row: "Human: unsupported", col: "Judge: supported" },
  { n: tn, label: "Both say unsupported", row: "Human: unsupported", col: "Judge: unsupported" },
];
---

<figure class="viz">
  <figcaption class="viz-head">
    <span class="viz-title">{title}</span>
    {subtitle && <span class="viz-subtitle">{subtitle}</span>}
  </figcaption>
  <div class="cm" role="table" aria-label={title}>
    <div role="row" class="cm-row">
      <span role="columnheader"></span>
      <span role="columnheader" class="cm-head">Judge says supported</span>
      <span role="columnheader" class="cm-head">Judge says unsupported</span>
    </div>
    {[0, 1].map((r) => (
      <div role="row" class="cm-row">
        <span role="rowheader" class="cm-head cm-side">{r === 0 ? "Human says supported" : "Human says unsupported"}</span>
        {[0, 1].map((c) => {
          const cell = cells[r * 2 + c];
          return (
            <span role="cell" class="cm-cell" style={`background:${shade(cell.n)}`} title={cell.label}>
              <strong>{cell.n}</strong>
              <small>{cell.label}</small>
            </span>
          );
        })}
      </div>
    ))}
  </div>
  {source && <p class="viz-source">{source}</p>}
</figure>

<style>
  .cm { display: grid; gap: 4px; max-width: 34rem; }
  .cm-row { display: grid; grid-template-columns: 8.5rem 1fr 1fr; gap: 4px; }
  .cm-head { color: var(--subtle); font-size: 0.78rem; text-align: center; align-self: end; }
  .cm-side { text-align: right; align-self: center; padding-right: 0.5rem; }
  .cm-cell {
    display: grid;
    place-content: center;
    gap: 0.1rem;
    min-height: 5.2rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    text-align: center;
  }
  .cm-cell strong { color: var(--text); font-size: 1.6rem; line-height: 1; }
  .cm-cell small { color: var(--text); opacity: 0.8; font-size: 0.72rem; line-height: 1.3; }
</style>
