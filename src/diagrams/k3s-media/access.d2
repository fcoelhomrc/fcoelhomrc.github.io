# Render: d2 --sketch --layout elk --pad 30 access.d2 access.svg
...@_style
direction: right

tv: TV or phone, at home\nor over Tailscale {class: human}
laptop: My terminal {class: human}

cluster: k3s on walnut {
  class: group
  lb: ServiceLB listens on\nthe host's own ports {class: model}
  public: Reachable from outside {
    class: group
    jellyfin: Jellyfin :8096 {class: box}
    seerr: Seerr :5055 {class: box}
  }
  internal: Cluster only {
    class: group
    grid-rows: 3
    sonarr: Sonarr :8989 {class: box}
    radarr: Radarr :7878 {class: box}
    prowlarr: Prowlarr :9696 {class: box}
    bazarr: Bazarr :6767 {class: box}
    qbit: qBittorrent :8080 {class: box}
  }
  lb -> public.jellyfin
  lb -> public.seerr
  public.seerr -> internal: calls by name,\nfor example http://sonarr:8989
}

tv -> cluster.lb: host address, port 8096
laptop -> cluster.internal: kubectl port-forward {style.stroke-dash: 3}

(** -> **)[*].style.stroke: "#908caa"
(** -> **)[*].style.font-color: "#908caa"
