# Shared look for the RAG evaluation diagrams: Rosé Pine ink on the card surface.
style.fill: "#1f1d2e"

classes: {
  box: {style: {fill: "#26233a"; stroke: "#6e6a86"; font-color: "#e0def4"; stroke-width: 2; border-radius: 6; font-size: 18}}
  model: {style: {fill: "#1e2b36"; stroke: "#9ccfd8"; font-color: "#e0def4"; stroke-width: 2; border-radius: 6; font-size: 18}}
  human: {style: {fill: "#2f2433"; stroke: "#ebbcba"; font-color: "#e0def4"; stroke-width: 2; border-radius: 6; font-size: 18}}
  result: {style: {fill: "#26233a"; stroke: "#f6c177"; font-color: "#e0def4"; stroke-width: 2; border-radius: 6; font-size: 18}}
  store: {shape: cylinder; style: {fill: "#26233a"; stroke: "#908caa"; font-color: "#e0def4"; stroke-width: 2; font-size: 18}}
  group: {style: {fill: "#1f1d2e"; stroke: "#524f67"; stroke-dash: 4; font-color: "#908caa"; font-size: 20}}
}
