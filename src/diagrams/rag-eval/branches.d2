# Render: d2 --sketch --layout elk --pad 30 branches.d2 branches.svg
...@_style
direction: down

q: Test question {class: box}

retrieval: Retrieval under test {
  class: group
  bm25: Rank chunks with BM25 {class: box}
  dense: Rank chunks with\na dense encoder {class: model}
  rrf: Fuse both rankings\nwith RRF {class: box}
  rerank: Rerank with a\ncross-encoder if enabled {class: model}
  bm25 -> rrf
  dense -> rrf
  rrf -> rerank
}

free: Free branch runs on every change {
  class: group
  gold: Compare retrieved ids\nwith gold ids {class: human}
  metrics: Rank metrics with\n95% intervals {class: result}
  gold -> metrics
}

paid: Paid branch runs on demand {
  class: group
  answer: Qwen3 30B answers\nfrom the chunks {class: model}
  judge: DeepSeek V4 Flash\ngrades the answer {class: model}
  scores: Four Ragas scores {class: result}
  answer -> judge -> scores
}

q -> retrieval.bm25
q -> retrieval.dense
retrieval.rerank -> free.gold: top-k ids
retrieval.rerank -> paid.answer: top-k chunks

(** -> **)[*].style.stroke: "#908caa"
(** -> **)[*].style.font-color: "#908caa"
