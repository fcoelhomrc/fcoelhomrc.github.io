# Render: d2 --sketch --layout elk --pad 30 judge.d2 judge.svg
...@_style
direction: right

cases: I write 83 statements\nagainst real abstracts {class: box}

human: Human labels {
  class: group
  blind: I label each statement\nwithout seeing my answer {class: human}
  labels: 81 labels remain\nafter 2 unsure are dropped {class: human}
  blind -> labels
}

model: Judge under test {
  class: group
  prompt: Ask whether the passage\nsupports the statement {class: box}
  judge: DeepSeek V4 Flash\nanswers 1 or 0 {class: model}
  prompt -> judge
}

kappa: Agreement is\nkappa 0.83 {class: result}

cases -> human.blind
cases -> model.prompt
human.labels -> kappa
model.judge -> kappa

(** -> **)[*].style.stroke: "#908caa"
(** -> **)[*].style.font-color: "#908caa"
