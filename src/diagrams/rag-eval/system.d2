# Render: d2 --sketch --layout elk --pad 30 system.d2 system.svg
...@_style
direction: right

ingest: Ingest workers {
  class: group
  scholar: Fetch arXiv PDFs\nfound on Semantic Scholar {class: box}
  chunk: Run OCR with Docling and\nsplit into 256-token chunks {class: box}
  embed: Embed each chunk\nwith four encoders {class: model}
  scholar -> chunk -> embed
}

query: Query path {
  class: group
  ui: Web app {class: box}
  agent: LangGraph agent\nwith four tools {class: model}
  retrieve: Search BM25 and vectors,\nthen fuse the rankings {class: box}
  ui -> agent: question
  agent -> retrieve: search call
}

pg: Postgres holds chunks\nand the text index {class: store}
pinecone: Pinecone holds\nchunk vectors {class: store}
phoenix: Phoenix holds\nagent traces {class: store}

ingest.chunk -> pg: writes chunks
ingest.embed -> pinecone: writes vectors
query.retrieve -> pg: reads text
query.retrieve -> pinecone: queries vectors
query.agent -> phoenix: sends traces {style.stroke-dash: 3}

(** -> **)[*].style.stroke: "#908caa"
(** -> **)[*].style.font-color: "#908caa"
