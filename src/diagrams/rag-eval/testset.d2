# Render: d2 --sketch --pad 30 testset.d2 testset.svg
...@_style
grid-rows: 2
grid-columns: 4
horizontal-gap: 70
vertical-gap: 70

corpus: Corpus\n100 papers\n11,381 chunks {class: store}
seed: Seed pool\n80 chunks per topic {class: box}
kg: Knowledge graph\none per topic {
  class: group
  grid-rows: 2
  vertical-gap: 40
  extract: LLM extracts summary\nthemes, entities {class: model}
  edges: Edges: similar summaries\nor shared entities {class: box}
}
synth: Ragas synthesizers {
  class: group
  grid-rows: 3
  vertical-gap: 20
  single: Single-hop specific, 15 {class: model}
  mhs: Multi-hop specific, 8 {class: model}
  mha: Multi-hop abstract, 8 {class: model}
}

b1: "" {style.opacity: 0}
curated: 100 questions\n20 per topic {class: result}
review: Review\nLLM pass, then quota {class: human}
map: Exact text lookup\nquestion to chunk ids {class: box}

corpus -> seed: sample
seed -> kg
kg.extract -> kg.edges
kg -> synth
synth -> map: 155 questions
map -> review
review -> curated

(** -> **)[*].style.stroke: "#908caa"
(** -> **)[*].style.font-color: "#908caa"
