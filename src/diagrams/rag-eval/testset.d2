# Render: d2 --sketch --pad 30 testset.d2 testset.svg
...@_style
grid-rows: 2
grid-columns: 4
horizontal-gap: 70
vertical-gap: 70

corpus: 100 papers\nin 11,381 chunks {class: store}
seed: Sample 80 seed\nchunks per topic {class: box}
kg: One knowledge graph per topic {
  class: group
  grid-rows: 2
  vertical-gap: 40
  extract: An LLM extracts summaries,\nthemes and entities {class: model}
  edges: Link chunks with similar\nsummaries or shared entities {class: box}
}
synth: Ragas writes three question types {
  class: group
  grid-rows: 3
  vertical-gap: 20
  single: 15 single-hop questions {class: model}
  mhs: 8 multi-hop specific questions {class: model}
  mha: 8 multi-hop abstract questions {class: model}
}

b1: "" {style.opacity: 0}
curated: Keep 100 questions,\n20 per topic {class: result}
review: An LLM review drops 34\nand a quota cuts 21 {class: human}
map: Look up each gold passage\nto get its chunk id {class: box}

corpus -> seed
seed -> kg
kg.extract -> kg.edges
kg -> synth
synth -> map: 155 questions
map -> review
review -> curated

(** -> **)[*].style.stroke: "#908caa"
(** -> **)[*].style.font-color: "#908caa"
