---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, projects } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);
const date = new Intl.DateTimeFormat("en", { dateStyle: "medium" });
const root = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout>
  <section class="intro">
    <img class="portrait" src={`${root}${profile.image}`} width="160" height="160" alt={`Portrait of ${profile.name}`} />
    <div>
      <p class="eyebrow">{profile.role}</p>
      <h1>{profile.name}</h1>
      <p class="lede">{profile.summary}</p>
      <div class="meta">{profile.location}</div>
      <div class="links">
        <a href={profile.github} data-track="profile-github">GitHub</a>
        <a href={profile.linkedin} data-track="profile-linkedin">LinkedIn</a>
        <a href={`mailto:${profile.email}`} data-track="profile-email">Email</a>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((project) => (
        <article class="card" data-project={project.name}>
          {project.coverImage && (
            project.repository ? (
              <a
                class="card-cover card-cover-link"
                href={project.repository}
                data-track="project-repo-cover"
                aria-label={`View ${project.name} repository`}
              >
                <img
                  src={`${root}${project.coverImage}`}
                  alt={project.coverAlt ?? ""}
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="card-cover">
                <img
                  src={`${root}${project.coverImage}`}
                  alt={project.coverAlt ?? ""}
                  loading="lazy"
                />
              </div>
            )
          )}
          <div class="card-header">
            <h3>
              {project.repository
                ? <a class="card-title" href={project.repository} data-track="project-repo-title">{project.name}</a>
                : project.name}
            </h3>
            <span class:list={["project-status", project.status]}>
              <span class="status-dot" aria-hidden="true"></span>
              {project.status === "active" ? "Active" : "Completed"}
            </span>
          </div>
          <p>{project.description}</p>
          <ul class="tags" aria-label="Technologies">
            {project.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>Writing</h2>
      <a href={`${root}blog/`}>All posts</a>
    </div>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.published.toISOString()}>{date.format(post.data.published)}</time>
          <h3><a class="card-title" href={`${root}blog/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
